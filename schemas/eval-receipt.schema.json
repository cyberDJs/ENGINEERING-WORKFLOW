{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Evaluation Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "evaluation_kind",
    "subject",
    "comparison",
    "change_scope",
    "corpus",
    "metrics",
    "thresholds",
    "security_review",
    "regression",
    "rollback",
    "verdict",
    "evidence",
    "environment",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 3
    },
    "evaluation_kind": {
      "enum": [
        "CHANGE_REGRESSION",
        "ARCHITECTURE_CHALLENGER",
        "MODEL_CANDIDATE",
        "RETRIEVAL_CANDIDATE",
        "WORKER_CANDIDATE"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 3
    },
    "comparison": {
      "type": "object",
      "required": [
        "champion_ref",
        "challenger_ref"
      ],
      "properties": {
        "champion_ref": {
          "type": "string",
          "minLength": 1
        },
        "challenger_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "change_scope": {
      "type": "object",
      "required": [
        "changed_dimensions",
        "controlled_dimensions"
      ],
      "properties": {
        "changed_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "controlled_dimensions": {
          "type": "array",
          "uniqueItems": true
        },
        "multi_dimension_exception_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "corpus": {
      "type": "object",
      "required": [
        "id",
        "digest",
        "validation_strategy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validation_strategy": {
          "enum": [
            "HOLDOUT",
            "DISJOINT"
          ]
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "baseline",
          "candidate",
          "delta"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "baseline": {
            "type": "number"
          },
          "candidate": {
            "type": "number"
          },
          "delta": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "operator",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              ">=",
              "<=",
              ">",
              "<",
              "=="
            ]
          },
          "value": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "environment": {
      "type": "object"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "security_review": {
      "type": "object",
      "required": [
        "status",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "regression": {
      "type": "object",
      "required": [
        "status",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "rollback": {
      "type": "object",
      "required": [
        "plan_ref",
        "verified"
      ],
      "properties": {
        "plan_ref": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
