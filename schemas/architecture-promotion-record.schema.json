{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Architecture Promotion Record",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "architecture",
    "decision",
    "gates",
    "release",
    "governance",
    "evidence",
    "residual_risks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 3
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "current_champion_ref",
        "candidate_ref",
        "changed_dimensions"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "current_champion_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_ref": {
          "type": "string",
          "minLength": 1
        },
        "changed_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "decision_record_ref",
        "decision_authority_type",
        "decision_authority_ref",
        "decided_at"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "ADOPT",
            "REJECT",
            "WATCH"
          ]
        },
        "decision_record_ref": {
          "type": "string",
          "minLength": 1
        },
        "decision_authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_authority_type": {
          "enum": [
            "POLICY",
            "OPERATOR",
            "PROJECT_AUTHORITY"
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eval_receipt_ref",
        "eval_verdict",
        "security_status",
        "security_evidence_ref",
        "regression_status",
        "regression_evidence_ref",
        "rollback_verified",
        "rollback_ref"
      ],
      "properties": {
        "eval_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "eval_verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "INCONCLUSIVE"
          ]
        },
        "security_status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        },
        "security_evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "regression_status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        },
        "regression_evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "rollback_verified": {
          "type": "boolean"
        },
        "rollback_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_version",
        "release_record_ref",
        "release_authority_ref",
        "production_eligible"
      ],
      "properties": {
        "architecture_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "release_authority_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "production_eligible": {
          "type": "boolean"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_grants_execution",
        "record_grants_release",
        "protected_operations_require_separate_authorization"
      ],
      "properties": {
        "record_grants_execution": {
          "const": false
        },
        "record_grants_release": {
          "const": false
        },
        "protected_operations_require_separate_authorization": {
          "const": true
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_risks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
