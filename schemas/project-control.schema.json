{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nulleimy/ENGINEERING-WORKFLOW/schemas/project-control.schema.json",
  "title": "ENGINEERING-WORKFLOW project control",
  "type": "object",
  "required": ["schema_version", "project", "control", "licensing", "cli", "quality"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "required": ["id", "name", "status", "product_owner", "technical_owner"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["concept", "discovery", "defined", "building", "validating", "operating", "maintenance", "retired", "archived"]},
        "product_owner": {"const": "Eimy Herrer"},
        "technical_owner": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "control": {
      "type": "object",
      "required": ["version", "canonical_repository", "default_branch", "normative_language", "governance_file", "technical_operating_mode", "product_decision_execution_constitution", "constitutional_authority", "constitutional_compatibility_report", "primary_engineering_invariant", "complexity_budget", "reversibility_classes", "manual_work_register", "lifecycle_evidence_graph"],
      "additionalProperties": true
    },
    "licensing": {
      "type": "object",
      "required": ["model", "intended_exclusive_rights_holder", "release_authority", "open_source_project_license_granted", "license_notice", "copyright_notice", "provenance_register", "policy", "exclusive_control_status", "distribution_requires_verified_exclusive_control"],
      "properties": {
        "model": {"const": "proprietary-all-rights-reserved"},
        "intended_exclusive_rights_holder": {"const": "Eimy Herrer"},
        "release_authority": {"const": "Eimy Herrer"},
        "open_source_project_license_granted": {"const": false},
        "license_notice": {"const": "LICENSE"},
        "copyright_notice": {"const": "COPYRIGHT"},
        "provenance_register": {"const": "governance/IP_PROVENANCE_REGISTER.json"},
        "policy": {"const": "governance/EXCLUSIVE_RIGHTS_AND_LICENSING_POLICY.md"},
        "exclusive_control_status": {"enum": ["BLOCKED_PENDING_CONTRIBUTOR_AND_AI_PROVENANCE_AUDIT", "VERIFIED_EXCLUSIVE_CONTROL"]},
        "distribution_requires_verified_exclusive_control": {"const": true}
      },
      "additionalProperties": false
    },
    "cli": {
      "type": "object",
      "required": ["version", "entrypoint", "foundation_document", "adoption_document", "commands", "git_required", "external_runtime_dependencies"],
      "properties": {
        "version": {"const": "0.3.0"},
        "entrypoint": {"const": "bin/ew"},
        "foundation_document": {"const": "platform/EW_CLI_FOUNDATION.md"},
        "adoption_document": {"const": "platform/EW_ADOPT_FOUNDATION.md"},
        "commands": {"const": ["init", "adopt", "doctor", "rollback", "self-test"]},
        "git_required": {"const": false},
        "external_runtime_dependencies": {"type": "array", "maxItems": 0}
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["validator", "constitutional_validator", "primary_invariant_validator", "supply_chain_validator", "licensing_validator", "cli_self_test", "tests", "release_requires_clean_validation", "portability"],
      "properties": {
        "licensing_validator": {"const": "python3 scripts/validate_licensing.py"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
