{
  "$id": "https://github.com/nulleimy/ENGINEERING-WORKFLOW/schemas/project-control.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "control": {
      "additionalProperties": true,
      "required": [
        "version",
        "canonical_repository",
        "default_branch",
        "normative_language",
        "governance_file",
        "technical_operating_mode",
        "product_decision_execution_constitution",
        "constitutional_authority",
        "constitutional_compatibility_report",
        "primary_engineering_invariant",
        "complexity_budget",
        "reversibility_classes",
        "manual_work_register",
        "lifecycle_evidence_graph",
        "ai_engineering_control_plane",
        "artifact_admission_schema",
        "project_context_packet_schema",
        "eval_receipt_schema",
        "capability_mapping_schema",
        "evaluation_suite_schema",
        "architecture_promotion_schema",
        "adversarial_review_suite_schema",
        "ai_dependency_inventory_schema",
        "constrained_task_plan_schema",
        "external_authority_binding_schema",
        "external_authority_adoption_schema"
      ],
      "type": "object"
    },
    "project": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "product_owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "concept",
            "discovery",
            "defined",
            "building",
            "validating",
            "operating",
            "maintenance",
            "retired",
            "archived"
          ]
        },
        "technical_owner": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "product_owner",
        "technical_owner"
      ],
      "type": "object"
    },
    "quality": {
      "additionalProperties": true,
      "required": [
        "validator",
        "constitutional_validator",
        "primary_invariant_validator",
        "supply_chain_validator",
        "tests",
        "release_requires_clean_validation",
        "ai_control_plane_validator",
        "trusted_context_builder",
        "eval_comparator",
        "adversarial_review_gate",
        "constrained_task_planner",
        "external_authority_projection",
        "external_authority_adoption_verifier",
        "incident_exercise_runner",
        "release_rehearsal_runner",
        "licensing_validator",
        "cli_self_test",
        "portability"
      ],
      "type": "object",
      "properties": {
        "licensing_validator": {
          "const": "python3 scripts/validate_licensing.py"
        }
      }
    },
    "schema_version": {
      "const": 1
    },
    "licensing": {
      "type": "object",
      "required": [
        "model",
        "intended_exclusive_rights_holder",
        "release_authority",
        "open_source_project_license_granted",
        "license_notice",
        "copyright_notice",
        "provenance_register",
        "policy",
        "exclusive_control_status",
        "distribution_requires_verified_exclusive_control",
        "provenance_audit"
      ],
      "properties": {
        "model": {
          "const": "proprietary-all-rights-reserved"
        },
        "intended_exclusive_rights_holder": {
          "const": "Eimy Herrer"
        },
        "release_authority": {
          "const": "Eimy Herrer"
        },
        "open_source_project_license_granted": {
          "const": false
        },
        "license_notice": {
          "const": "LICENSE"
        },
        "copyright_notice": {
          "const": "COPYRIGHT"
        },
        "provenance_register": {
          "const": "governance/IP_PROVENANCE_REGISTER.json"
        },
        "policy": {
          "const": "governance/EXCLUSIVE_RIGHTS_AND_LICENSING_POLICY.md"
        },
        "exclusive_control_status": {
          "enum": [
            "BLOCKED_PENDING_CONTRIBUTOR_AND_AI_PROVENANCE_AUDIT",
            "VERIFIED_EXCLUSIVE_CONTROL",
            "AUDIT_COMPLETE_BLOCKED_PENDING_RIGHTS_RESOLUTION"
          ]
        },
        "distribution_requires_verified_exclusive_control": {
          "const": true
        },
        "provenance_audit": {
          "const": "evidence/IP_PROVENANCE_AUDIT_20260726.json"
        }
      },
      "additionalProperties": false
    },
    "cli": {
      "type": "object",
      "required": [
        "version",
        "entrypoint",
        "foundation_document",
        "adoption_document",
        "commands",
        "git_required",
        "external_runtime_dependencies"
      ],
      "properties": {
        "version": {
          "const": "0.3.0"
        },
        "entrypoint": {
          "const": "bin/ew"
        },
        "foundation_document": {
          "const": "platform/EW_CLI_FOUNDATION.md"
        },
        "adoption_document": {
          "const": "platform/EW_ADOPT_FOUNDATION.md"
        },
        "commands": {
          "const": [
            "init",
            "adopt",
            "doctor",
            "rollback",
            "self-test"
          ]
        },
        "git_required": {
          "const": false
        },
        "external_runtime_dependencies": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project",
    "control",
    "quality",
    "operations_rehearsal_runner",
    "licensing",
    "cli"
  ],
  "title": "ENGINEERING-WORKFLOW project control",
  "type": "object"
}
