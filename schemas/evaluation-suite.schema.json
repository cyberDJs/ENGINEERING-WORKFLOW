{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Evaluation Suite Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "suite_id",
    "capability_class",
    "executor",
    "case_set",
    "comparison",
    "metrics",
    "regression_policy",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "suite_id": {
      "type": "string",
      "minLength": 3
    },
    "capability_class": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "authority_type",
        "ref"
      ],
      "properties": {
        "authority_type": {
          "enum": [
            "SKILLS_CAPABILITY_EVALUATOR",
            "SPECIALIZED_HARNESS",
            "PROJECT_NATIVE",
            "OTHER"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case_set": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "digest",
        "case_ids",
        "validation_strategy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_strategy": {
          "enum": [
            "REGRESSION",
            "HOLDOUT",
            "DISJOINT"
          ]
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paired_case_ids",
        "baseline_required",
        "fail_on_case_set_mismatch"
      ],
      "properties": {
        "paired_case_ids": {
          "const": true
        },
        "baseline_required": {
          "const": true
        },
        "fail_on_case_set_mismatch": {
          "const": true
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "name",
          "field",
          "aggregation",
          "direction",
          "threshold"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "aggregation": {
            "enum": [
              "mean",
              "sum"
            ]
          },
          "direction": {
            "enum": [
              "higher_is_better",
              "lower_is_better"
            ]
          },
          "threshold": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operator",
              "value"
            ],
            "properties": {
              "operator": {
                "enum": [
                  ">=",
                  "<=",
                  ">",
                  "<",
                  "=="
                ]
              },
              "value": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "regression_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fail_on_candidate_critical",
        "critical_severities",
        "max_new_failures",
        "no_pass_rate_regression"
      ],
      "properties": {
        "fail_on_candidate_critical": {
          "const": true
        },
        "critical_severities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          }
        },
        "max_new_failures": {
          "type": "integer",
          "minimum": 0
        },
        "no_pass_rate_regression": {
          "type": "boolean"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functional_only",
        "security_evaluation_separate",
        "promotion_authority"
      ],
      "properties": {
        "functional_only": {
          "const": true
        },
        "security_evaluation_separate": {
          "const": true
        },
        "promotion_authority": {
          "const": false
        }
      }
    }
  },
  "additionalProperties": false
}
