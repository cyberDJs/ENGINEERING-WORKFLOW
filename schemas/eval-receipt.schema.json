{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Evaluation Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "evaluation_kind",
    "subject",
    "comparison",
    "change_scope",
    "corpus",
    "metrics",
    "thresholds",
    "verdict",
    "evidence",
    "environment",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 3
    },
    "evaluation_kind": {
      "enum": [
        "CHANGE_REGRESSION",
        "ARCHITECTURE_CHALLENGER",
        "MODEL_CANDIDATE",
        "RETRIEVAL_CANDIDATE",
        "WORKER_CANDIDATE"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 3
    },
    "comparison": {
      "type": "object",
      "required": [
        "champion_ref",
        "challenger_ref"
      ],
      "properties": {
        "champion_ref": {
          "type": "string",
          "minLength": 1
        },
        "challenger_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "change_scope": {
      "type": "object",
      "required": [
        "changed_dimensions",
        "controlled_dimensions"
      ],
      "properties": {
        "changed_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "controlled_dimensions": {
          "type": "array",
          "uniqueItems": true
        },
        "multi_dimension_exception_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "corpus": {
      "type": "object",
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "array",
      "minItems": 1
    },
    "thresholds": {
      "type": "array",
      "minItems": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "environment": {
      "type": "object"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
